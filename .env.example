# PowerShell: set these as environment variables; Python does not auto-load .env.
# Docker Compose can read a copied .env via --env-file .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=olist
PGUSER=olist
PGPASSWORD=replace-with-your-local-password
# Alternative: DATABASE_URL=postgresql://user:password@localhost:5432/olist
# Only for integration tests against a dedicated disposable database:
# OLIST_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/olist_test
# Generate real local values with python scripts/configure_local.py (never overwrites .env).
AIRFLOW_DB_PASSWORD=replace-with-url-safe-local-password
AIRFLOW_FERNET_KEY=replace-with-generated-fernet-key
AIRFLOW_JWT_SECRET=replace-with-generated-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-local-admin-password
# Empty means manual DAG runs; e.g. 0 2 * * * means daily at 02:00 UTC.
OLIST_SCHEDULE=
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=olist.orders.v1
KAFKA_GROUP_ID=olist-postgres-v1
